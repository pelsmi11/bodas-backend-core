# Active Spring profile: dev (local Redis via docker-compose) or prod (ElastiCache via SSM tunnel)
SPRING_PROFILES_ACTIVE=dev

# Database Configuration
DB_URL=jdbc:postgresql://<db-host>/<db-name>?sslmode=require
DB_USERNAME=<db-username>
DB_PASSWORD=<db-password>

# AWS Configuration
AWS_REGION=us-east-1
AWS_PROFILE=<aws-profile-name>

# Security - Cognito
COGNITO_ISSUER_URI=https://cognito-idp.us-east-1.amazonaws.com/<user-pool-id>
COGNITO_APP_CLIENT_ID=<app-client-id>  # public identifier (non-secret)

# App Custom Properties
S3_BUCKET_NAME=<s3-bucket-name>
WEBHOOK_PARAMETER_PATH=/bodas/backend/
PHOTO_DOWNLOAD_URL_TTL=PT1H
PHOTO_FEED_LIMIT=120
PHOTO_MAX_UPLOAD_SIZE_BYTES=26214400
PHOTO_FEED_HEARTBEAT_MS=25000
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,https://bodas.pelsmi.website

# Redis Configuration
# Handled automatically by Spring profiles (see application-dev.yml / application-prod.yml).
# - dev profile  -> 127.0.0.1 (local docker-compose)
# - prod profile -> <elastichache-endpoint> (ElastiCache via SSM tunnel)
# To override manually, uncomment REDIS_HOST:
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379

# Set to false for local development when Redis is not reachable
APP_REDIS_LISTENER_ENABLED=true

# Both dev and prod load the moderation-webhook SecureString from Parameter Store.
